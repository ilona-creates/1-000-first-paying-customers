<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Your first 1,000 paying customers — Ilona Melnychuk</title>
<meta name="description" content="A course to get your startup its first 1,000 paying customers. For first-time founders of startups. Enrolment opens early-2027.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FCFCFA;      /* warm white — the wall */
    --sky:#CDE7F2;        /* open sky through the window */
    --sky-soft:#E3F1F7;    /* section wash */
    --leaf-soft:#E7F1E1;   /* section wash */
    --sky-deep:#9FCFE3;   /* button glass */
    --sky-hover:#8CC2D9;
    --sun:#E0824A;        /* sunset — button colour */
    --sun-hover:#CF7038;
    --sky-line:#E9E9E3;
    --leaf:#2E6B28;       /* the plant on the sill */
    --leaf-tint:#FCFCFA;
    --frame:#E7DFC9;      /* window frame / sill wood */
    --ink:#22251F;        /* sumi ink */
    --text:#3A3D35;       /* body */
    --soft:#93968D;       /* small print */
    --lemon:#F9E876;      /* sunlight */
    --lilac:#D9CCF6;
    --lilac-line:#B3A0E4;
    --lilac-hover:#CDBCF2;
    --btn-text:#173040;
    --rule:#ECECE6;
    --dot:rgba(34,37,31,0.09);
    --max:1060px;
    --narrow:640px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background-color:var(--paper);
    background-image:radial-gradient(var(--dot) 1.3px, transparent 1.3px);
    background-size:24px 24px;
    background-position:0 0;
    background-attachment:fixed;
    color:var(--text);
    font-family:'Lora', Georgia, serif;
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Raleway', 'Helvetica Neue', sans-serif;
    color:var(--ink);
    font-weight:500;
    line-height:1.25;
    letter-spacing:0.01em;
    text-wrap:balance;
  }
  p, li{text-wrap:pretty;}
  .ital{font-style:italic;font-weight:700;}
  strong{
    font-weight:600;color:var(--ink);
    background:linear-gradient(transparent 62%, var(--lemon) 62%);
    padding:0 2px;
  }
  em{font-style:normal;font-weight:600;color:var(--ink);}
  img{max-width:100%;display:block;}

  .wrap{max-width:var(--max);margin:0 auto;padding:0 24px;}
  .narrow{max-width:var(--narrow);margin-left:auto;margin-right:auto;}

  /* ---------- Header ---------- */
  header{
    position:sticky;top:0;z-index:10;
    background:rgba(252,252,250,0.86);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--rule);
  }
  .header-inner{
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 0;
  }
  .brand{
    font-family:'Raleway',sans-serif;
    font-weight:600;font-size:16px;letter-spacing:0.02em;
    color:var(--ink);text-decoration:none;
  }

  /* ---------- Buttons / CTA block ---------- */
  .btn{
    display:inline-block;
    font-family:'Raleway',sans-serif;
    font-size:14px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;
    color:var(--btn-text);
    background:var(--lilac);
    border:1.5px solid var(--ink);
    border-radius:999px;
    padding:14px 38px;
    text-decoration:none;
    transition:background .18s ease, transform .18s ease;
  }
  .btn:hover{background:var(--lilac-hover);transform:translateY(-1px);}
  .btn:focus-visible{outline:3px solid var(--lilac-line);outline-offset:3px;}
  .btn.small{padding:9px 22px;font-size:14px;}
  .cta{text-align:center;margin-top:34px;}
  .cta .note{
    display:block;margin-top:12px;
    font-family:'Raleway',sans-serif;
    font-size:12.5px;letter-spacing:0.04em;
    color:var(--soft);
  }

  /* ---------- Sections ---------- */
  section{padding:120px 0;}
  section + section{border-top:none;position:relative;}
  section + section::before{
    content:"";position:absolute;top:0;left:50%;
    width:32px;height:1px;background:var(--rule);
    transform:translateX(-50%);
  }
  section.tint-sky{
    background-image:radial-gradient(var(--dot) 1.3px, transparent 1.3px),
      linear-gradient(160deg, #EAF6FB 0%, var(--sky-soft) 55%, #D9EBF3 100%);
    background-size:24px 24px, 100% 100%;
    background-position:0 0, 0 0;
    background-attachment:fixed, scroll;
  }
  section.tint-leaf{
    background-image:radial-gradient(var(--dot) 1.3px, transparent 1.3px),
      linear-gradient(160deg, #EFF7EA 0%, var(--leaf-soft) 55%, #DCEBD3 100%);
    background-size:24px 24px, 100% 100%;
    background-position:0 0, 0 0;
    background-attachment:fixed, scroll;
  }
  section.lifestyle{
    background-image:radial-gradient(var(--dot) 1.3px, transparent 1.3px),
      linear-gradient(180deg, #E7F3DE 0%, #F1F8EB 45%, var(--paper) 100%);
    background-size:24px 24px, 100% 100%;
    background-position:0 0, 0 0;
    background-attachment:fixed, scroll;
  }

  .eyebrow{
    font-family:'Raleway',sans-serif;
    font-size:12px;font-weight:600;
    letter-spacing:0.22em;text-transform:uppercase;
    color:var(--leaf);
    text-align:center;
  }

  /* --- 1. Hero --- */
  .hero{
    text-align:center;padding-top:52px;padding-bottom:72px;
    min-height:calc(100svh - 61px);display:flex;align-items:center;
    background-image:radial-gradient(var(--dot) 1.3px, transparent 1.3px),
      linear-gradient(180deg, var(--sky) 0%, rgba(205,231,242,0) 62%);
    background-size:24px 24px, 100% 100%;
    background-position:0 0, 0 0;
    background-attachment:fixed, scroll;
  }
  .hero .wrap{width:100%;}
  .hero .pre{
    font-size:17px;font-weight:600;color:var(--text);
    margin-top:20px;
  }
  .hero h1{
    font-size:clamp(38px,5.4vw,62px);
    font-weight:500;
    margin:14px auto 16px;
    max-width:14em;
  }
  .hero .sub{font-size:18px;max-width:34em;margin:0 auto;}

  .options{
    margin-top:0;
    text-align:left;
  }
  .options h2{font-size:clamp(28px,3.6vw,38px);margin-bottom:30px;}
  .steps-list{list-style:none;font-size:17px;}
  .steps-list li{
    position:relative;
    padding:10px 0 10px 36px;
  }
  .steps-list li + li{border-top:1px solid var(--rule);}
  .flame-list li{padding-left:0;display:flex;align-items:center;gap:14px;}
  .flame-icon{
    display:inline-flex;align-items:center;justify-content:center;
    flex:0 0 32px;height:32px;
  }
  .flame-icon.size-1 svg{width:16px;height:16px;}
  .flame-icon.size-2 svg{width:23px;height:23px;}
  .flame-icon.size-3 svg{width:32px;height:32px;}
  .options .kicker{
    margin-top:30px;font-weight:600;font-size:17px;color:var(--ink);
    line-height:1.8;
  }
  mark{
    background:linear-gradient(transparent 58%, var(--lemon) 58%);
    color:inherit;padding:0 2px;
    -webkit-box-decoration-break:clone;box-decoration-break:clone;
  }

  /* --- Split layout (2, 4, 8) --- */
  .split{
    display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;
  }
  .split.flip .media{order:2;}
  .media{
    border:1px solid var(--rule);
    border-radius:2px;
    overflow:hidden;
    background:#FCFCFA;
    position:relative;
    aspect-ratio:4/5;
    display:flex;align-items:center;justify-content:center;
  }
  
  .media span{
    font-family:'Raleway',sans-serif;font-size:12px;
    letter-spacing:0.1em;text-transform:uppercase;color:var(--soft);
  }
  .media .sill-plant{display:none;}

  /* --- 2. Lifestyle --- */
  .lifestyle{
    padding:56px 0;
    min-height:100svh;
    display:flex;align-items:center;
  }
  .lifestyle .wrap{width:100%;}
  .lifestyle h2{font-size:clamp(26px,3.4vw,36px);margin-bottom:26px;text-align:center;}
  .poem{text-align:center;}
  .lifestyle .stanza{
    font-size:16px;line-height:1.75;
    margin-bottom:20px;
  }
  .lifestyle .cta{text-align:center;margin-top:26px;}
  .lifestyle .split{align-items:stretch;}
  .lifestyle .media{aspect-ratio:auto;height:100%;width:100%;}

  /* --- 3. Problem --- */
  .problem h2{
    font-size:clamp(26px,3.4vw,36px);
    text-align:center;max-width:22em;margin:0 auto 64px;
    line-height:1.35;
  }
  .but-line{
    display:block;margin-top:22px;
    font-family:'Lora',Georgia,serif;
    font-size:19px;font-weight:500;
    color:var(--text);letter-spacing:0;
  }
  .but-line .but{
    font-style:normal;font-weight:700;
    font-family:'Raleway',sans-serif;
    color:var(--leaf);letter-spacing:0.06em;
  }
  .problem h2 mark{padding:0 4px;}
  .pain{max-width:40em;margin:0 auto 34px;}
  .pain .main{font-size:17px;line-height:1.65;}
  .pain .aside{
    font-size:15.5px;color:#8A9490;
    margin-top:4px;
    padding-left:28px;
  }
  blockquote{
    text-wrap:balance;
    font-weight:600;font-size:clamp(20px,2.6vw,24px);
    color:var(--ink);line-height:1.5;
    text-align:center;max-width:26em;
    margin:0 auto;
  }

  /* --- Overwhelm quote --- */
  .overwhelm{
    padding:130px 0;
    text-align:center;
    position:relative;overflow:hidden;
  }
  .overwhelm blockquote{
    font-family:'Lora',Georgia,serif;font-style:italic;font-weight:400;
    font-size:clamp(26px,3.4vw,38px);line-height:1.55;color:var(--ink);
    max-width:23em;margin:0 auto;text-wrap:balance;text-align:center;
    position:relative;z-index:1;
  }
  .ghost-quote{
    position:absolute;
    top:-0.55em;left:-0.55em;
    font-size:3.2em;line-height:1;
    color:var(--leaf);opacity:0.14;
    font-style:normal;
    pointer-events:none;
  }
  .chaos{
    position:absolute;
    font-family:'Lora',Georgia,serif;font-style:italic;
    font-size:14px;color:#9AA792;
    opacity:0;
    transform:rotate(var(--r,0deg));
    animation:chaosIn 1s ease forwards, chaosFloat 7s ease-in-out infinite;
    animation-delay:var(--d,0s), calc(var(--d,0s) + 1s);
  }
  @keyframes chaosIn{
    to{opacity:0.55;}
  }
  @keyframes chaosFloat{
    0%,100%{translate:0 0;}
    50%{translate:0 -7px;}
  }
  @media (max-width:820px){
    .overwhelm{padding:78px 0;}
    .chaos{font-size:12.5px;}
    .chaos:nth-of-type(even){display:none;}
    .ghost-quote{left:-0.15em;}
  }
  @media (prefers-reduced-motion: reduce){
    .chaos{animation:none;opacity:0.42;}
  }

  /* --- Income statement --- */
  .income-statement{
    padding:130px 0;
    text-align:center;
    position:relative;
    overflow:hidden;
    background-image:radial-gradient(var(--dot) 1.3px, transparent 1.3px),
      linear-gradient(180deg, #AFD89B 0%, #CDE6BC 45%, #E7F3DE 100%);
    background-size:24px 24px, 100% 100%;
    background-position:0 0, 0 0;
    background-attachment:fixed, scroll;
  }
  .income-line{
    font-family:'Lora',Georgia,serif;font-style:italic;font-weight:400;
    font-size:clamp(26px,3.4vw,38px);line-height:1.55;color:var(--ink);
    max-width:23em;margin:0 auto;text-wrap:balance;
  }
  @media (min-width:901px){
    .income-statement .wrap{padding-right:300px;}
  }
  @media (min-width:821px) and (max-width:900px){
    .income-statement .wrap{padding-right:220px;}
  }
  .stamp{
    position:absolute;
    width:320px;height:320px;
    right:3%;top:44px;
    transform:rotate(-8deg);
  }
  @media (max-width:900px){
    .stamp{width:210px;height:210px;right:3%;top:26px;}
  }
  @media (max-width:820px){
    .income-statement{padding:72px 0;}
    .income-statement .wrap{padding-right:0;}
    .stamp{position:static;margin:0 auto 36px;transform:rotate(-6deg);}
  }

  /* --- Manifesto --- */
  .manifesto{
    background:var(--leaf-tint);
    padding:110px 0;
    text-align:center;
  }
  .manifesto-icon{width:34px;height:34px;margin:0 auto 18px;display:block;}
  .manifesto-eyebrow{
    font-family:'Raleway',sans-serif;font-size:13px;font-weight:600;
    letter-spacing:0.16em;text-transform:uppercase;color:var(--leaf);
    margin-bottom:26px;
  }
  .manifesto-line{
    font-family:'Lora',Georgia,serif;font-style:italic;font-weight:400;
    font-size:clamp(26px,3.4vw,38px);line-height:1.55;color:var(--ink);
    max-width:23em;margin:0 auto;text-wrap:balance;
  }
  .manifesto-line mark{
    background:linear-gradient(transparent 55%, var(--lemon) 55%);
    background-repeat:no-repeat;
    background-size:0% 100%;
    transition:background-size .8s cubic-bezier(.25,.7,.3,1);
    padding:0 3px;
  }
  .manifesto-line.in mark{background-size:100% 100%;}
  .manifesto-rule{width:56px;height:1px;background:var(--leaf);opacity:.4;margin:34px auto 0;}
  @media (max-width:820px){
    .manifesto{padding:72px 0;}
  }
  @media (prefers-reduced-motion: reduce){
    .manifesto-line mark{background-size:100% 100%;transition:none;}
  }

  /* --- 4. Guide --- */
  .guide h2{font-size:clamp(26px,3.4vw,34px);margin-bottom:28px;}
  .guide p{margin-bottom:22px;line-height:1.75;}
  .signature{
    font-style:italic;font-size:26px;color:var(--ink);
    text-align:right;padding-right:12%;
  }
  .sig-role{
    font-family:'Lora',Georgia,serif;
    font-style:normal;font-size:16px;color:var(--text);
  }
  .guide-photo{margin:0;}
  .guide-photo img{
    width:100%;border-radius:2px;
    border:1px solid var(--sky-line);
  }
  .guide-photo figcaption{
    font-family:'Raleway',sans-serif;
    font-size:13px;line-height:1.6;color:var(--soft);
    margin-top:10px;
    text-align:center;
  }

  /* --- 5. Controlling idea --- */
  .idea{text-align:center;}
  .idea h2{
    font-size:clamp(30px,4vw,42px);
    font-weight:700;
    max-width:18em;margin:18px auto 54px;
  }
  .idea .arrow{color:var(--ink);}
  .learn{max-width:38em;margin:0 auto;text-align:left;}
  .learn p{margin-bottom:20px;font-size:17px;}
  .learn .label{
    font-family:'Raleway',sans-serif;
    font-size:16px;font-weight:700;letter-spacing:0.03em;
    color:var(--ink);
  }

  /* --- 6. Plan --- */
  .plan h2{font-size:clamp(28px,3.6vw,38px);margin-bottom:34px;}
  .plan ol{
    font-size:17px;line-height:2;
    padding-left:1.3em;
  }
  .plan .cta{text-align:left;margin-top:34px;}

  /* --- 7. Stakes --- */
  .stakes{text-align:center;}
  .stakes h2{
    font-size:clamp(30px,4vw,42px);
    max-width:16em;margin:0 auto 48px;
  }
  .stakes p{font-size:17px;margin-bottom:18px;}

  /* --- 8. Success --- */
  .success h2{font-size:clamp(30px,4vw,42px);margin-bottom:38px;}
  .success p{font-size:17px;margin-bottom:18px;}
  .success .cta{text-align:left;margin-top:36px;}

  footer{
    background:var(--paper);
    border-top:1px solid var(--rule);
    padding:56px 0 72px;text-align:center;
    font-family:'Raleway',sans-serif;
    font-size:12px;color:var(--soft);letter-spacing:0.18em;text-transform:uppercase;
  }

  /* ---------- Reveal on scroll ---------- */
  .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease, transform .7s ease;}
  .reveal.in{opacity:1;transform:none;}
  @media (prefers-reduced-motion: reduce){
    .reveal{opacity:1;transform:none;transition:none;}
    html{scroll-behavior:auto;}
    .btn:hover{transform:none;}
  }

  /* ---------- Mobile ---------- */
  @media (max-width:820px){
    body{font-size:16px;}
    section{padding:68px 0;}
    .split{grid-template-columns:1fr;gap:36px;}
    .split.flip .media{order:0;}
    .pair .turn{padding-left:6%;}
    .lifestyle .cta, .success .cta{text-align:center;}
  }
</style>
</head>
<body>

<header>
  <div class="wrap header-inner">
    <a class="brand" href="#top">Ilona Melnychuk</a>
    <a class="btn small" href="#waitlist">Get on waitlist</a>
  </div>
</header>

<main id="top">

  <!-- 1. Hero + options -->
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow reveal">For first-time founders of startups</p>
      <p class="pre reveal">You’ve built your product, but don’t (yet) have paying customers</p>
      <h1 class="reveal">Your first 1,000 paying customers</h1>
      <p class="sub reveal">A marketing course to get your startup its first 1,000 paying customers</p>
      <div class="cta reveal">
        <a class="btn" href="#waitlist">Get on waitlist</a>
        <span class="note">Enrolment opens early-2027</span>
      </div>
    </div>
  </section>

  <!-- Learn to market and sell -->
  <section class="options-section">
    <div class="wrap split">
      <div class="options reveal">
        <h2>Learn to market and sell the value you've built</h2>
        <ul class="steps-list flame-list">
          <li><span class="flame-icon size-1"><svg class="flame" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M13 22.3c-4.2 0-7.1-2.8-7.1-6.6 0-2.7 1.5-4.6 2.9-6.3.6 1 1.1 1.6 1.8 2-.4-2.7.5-5.5 3-7.9 0 2.4.8 3.8 2.2 5.3 1.7 1.8 3.1 3.6 3.1 6.1 0 4.1-2 7.4-5.9 7.4z" fill="#F4E066"/>
  <path d="M13 19.7c-2 0-3.4-1.3-3.4-3.3 0-1.1.6-2 1.2-2.8.2.5.6.9 1 1.1-.2-1.3.3-2.6 1.4-3.8 0 1.1.4 1.8 1.1 2.6.7.8 1.4 1.7 1.4 2.9 0 1.9-1.1 3.3-2.7 3.3z" fill="var(--lilac-line)"/>
  <path d="M13 17c-.7 0-1.1-.5-1.1-1.1 0-.5.3-.9.5-1.2.2.5.6.7 1 .7.4 0 .7-.2.9-.5.2.4.3.7.3 1-.1.6-.6 1.1-1.6 1.1z" fill="var(--sky-deep)"/>
</svg></span>Get your 1,000 paying customers</li>
          <li><span class="flame-icon size-2"><svg class="flame" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M13 22.3c-4.2 0-7.1-2.8-7.1-6.6 0-2.7 1.5-4.6 2.9-6.3.6 1 1.1 1.6 1.8 2-.4-2.7.5-5.5 3-7.9 0 2.4.8 3.8 2.2 5.3 1.7 1.8 3.1 3.6 3.1 6.1 0 4.1-2 7.4-5.9 7.4z" fill="#F4E066"/>
  <path d="M13 19.7c-2 0-3.4-1.3-3.4-3.3 0-1.1.6-2 1.2-2.8.2.5.6.9 1 1.1-.2-1.3.3-2.6 1.4-3.8 0 1.1.4 1.8 1.1 2.6.7.8 1.4 1.7 1.4 2.9 0 1.9-1.1 3.3-2.7 3.3z" fill="var(--lilac-line)"/>
  <path d="M13 17c-.7 0-1.1-.5-1.1-1.1 0-.5.3-.9.5-1.2.2.5.6.7 1 .7.4 0 .7-.2.9-.5.2.4.3.7.3 1-.1.6-.6 1.1-1.6 1.1z" fill="var(--sky-deep)"/>
</svg></span>Ditch ‘early-stage startup’ and call it a business</li>
          <li><span class="flame-icon size-3"><svg class="flame" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <path d="M13 22.3c-4.2 0-7.1-2.8-7.1-6.6 0-2.7 1.5-4.6 2.9-6.3.6 1 1.1 1.6 1.8 2-.4-2.7.5-5.5 3-7.9 0 2.4.8 3.8 2.2 5.3 1.7 1.8 3.1 3.6 3.1 6.1 0 4.1-2 7.4-5.9 7.4z" fill="#F4E066"/>
  <path d="M13 19.7c-2 0-3.4-1.3-3.4-3.3 0-1.1.6-2 1.2-2.8.2.5.6.9 1 1.1-.2-1.3.3-2.6 1.4-3.8 0 1.1.4 1.8 1.1 2.6.7.8 1.4 1.7 1.4 2.9 0 1.9-1.1 3.3-2.7 3.3z" fill="var(--lilac-line)"/>
